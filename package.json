{
  "name": "uptimeworker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:performance": "vitest run tests/performance",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "deploy:prepare": "node scripts/prepare-deploy.mjs",
    "deploy:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.json",
    "deploy": "wrangler deploy",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "hono": "4.13.14",
    "jose": "6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261023.1-beta",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
